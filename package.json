{
  "name": "note-block-editor",
  "version": "0.5.0",
  "description": "Pattern-based desktop editor for Note Block Songs",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "smoke": "node scripts/smoke.cjs",
    "pack:win": "electron-builder --win zip --x64",
    "smoke:packaged": "node scripts/smoke.cjs --packaged",
    "analyze:nbs": "node scripts/analyze-nbs.cjs",
    "smoke:smart": "node scripts/smart-import-smoke.cjs",
    "smoke:phrases": "node scripts/phrase-interaction-smoke.cjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.8.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "6.0.0",
    "playwright": "^1.64.1",
    "pnpm": "11.25.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  }
}
